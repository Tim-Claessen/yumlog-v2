{
  // Deployed via Cloudflare's Workers-Builds Git integration (not the
  // classic Pages product) — functions/ does NOT auto-route here, so
  // worker.ts manually dispatches /api/* routes and falls back to ASSETS
  // for the static build. See CLAUDE.md "Deployment (Cloudflare)".
  "name": "yumlog",
  "compatibility_date": "2025-01-01",
  "main": "worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  // Daily keep-alive ping to Supabase (worker.ts "scheduled" handler) so the
  // free-tier project isn't auto-paused for inactivity. 03:00 UTC ≈ 1pm AEST.
  "triggers": {
    "crons": ["0 3 * * *"]
  }
}
